# =============================================================================
# DOCKER & COMPOSE CONFIGURATION
# =============================================================================
COMPOSE_PROJECT_NAME=llm-service
DOCKER_CONTAINERS_RESTART=no
GRPC_MAX_MSG_MB=128
HUGGING_FACE_HUB_TOKEN=""
TZ=UTC

# =============================================================================
# QDRANT SERVICE CONFIGURATION
# =============================================================================
QDRANT_HOST="localhost"
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_UPSERT_BATCH=1000


# =============================================================================
# EMBEDDER SERVICE CONFIGURATION
# =============================================================================
EMBEDDER_HOST="localhost"
EMBEDDER_GRPC_PORT=50051
EMBEDDER_DIMENSIONS=1024
EMBEDDER_EMBED_BATCH_MAX_SIZE=16
EMBEDDER_MAX_CONCURRENCY=16
EMBEDDER_MAX_SEQ_LENGTH=256
EMBEDDER_MODEL_NAME=BAAI/bge-m3

# PyTorch Configuration
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
TORCH_NUM_THREADS=8

# =============================================================================
# RAG SERVICE CONFIGURATION
# =============================================================================
RETRIEVER_HOST="localhost"
RETRIEVER_GRPC_PORT=50052

# RAG Search Configuration
TOP_K=80
TOP_M=10
CONTEXT_WINDOW_SIZE=3
INCLUDE_WHOLE_PARAGRAPH=true

# RAG Fusion Weights
WEIGHT_RRF=0.3
WEIGHT_BM25=0.3
WEIGHT_SEMANTIC=0.4
WEIGHT_NEURAL=1.0

# Neural Reranker Configuration
RERANK_MODEL_NAME=BAAI/bge-reranker-v2-m3
RERANK_BATCH=16
RERANK_TOPN=20
RERANK_MAX_LEN=512

# =============================================================================
# INGESTION SERVICE CONFIGURATION
# =============================================================================
INGESTOR_HOST="localhost"
INGESTOR_HTTP_PORT=50053

# gRPC settings
INGESTOR_MAX_WORKERS=10
INGESTOR_GRPC_REFLECTIONS=1

# Chunking settings
CHUNK_SIZE=200
CHUNK_OVERLAP=20

# Character-based chunking parameters
CHARS_MIN_PER_CHUNK=2975
CHARS_TARGET_PER_CHUNK=7155
CHARS_MAX_PER_CHUNK=11130
CHARS_HARD_MAX=15000
CHUNK_OVERLAP_CHARS=954

# Layout analysis and OCR quality
OCR_WORD_CYR_RATIO_THRESHOLD=0.50
OCR_MATH_SYM_RATIO_THRESHOLD=0.10
HEADER_FOOTER_FREQ=0.55
COLUMN_MAX=3
COLUMN_GAP_TOLERANCE=0.035
LINE_MERGE_Y_RATIO=0.70

# =============================================================================
# VLLM MATH SERVICE CONFIGURATION
# =============================================================================
VLLM_MATH_HOST="localhost"
VLLM_MATH_PORT=50054

# VLLM Math Model Configuration
VLLM_MATH_MODEL_SRC=hasibirok0/ft-Qwen-Qwen2.5-Math-7B-Instruct-AWQ
VLLM_MATH_MAX_LEN=4096
VLLM_MATH_TP_SIZE=1
VLLM_MATH_HF_CACHE_DIR=/data/hf-cache
VLLM_MATH_GPU_UTIL=0.92
VLLM_MATH_DTYPE=auto


# =============================================================================
# VLLM TALKING SERVICE CONFIGURATION
# =============================================================================
VLLM_TALKING_HOST="localhost"
VLLM_TALKING_PORT=8000

# VLLM Talking Model Configuration
VLLM_TALKING_MODEL_SRC=Qwen/Qwen2.5-7B-Instruct-AWQ
VLLM_TALKING_MAX_LEN=4096
VLLM_TALKING_TP_SIZE=1
VLLM_TALKING_HF_CACHE_DIR=/data/hf-cache
VLLM_TALKING_GPU_UTIL=0.92
VLLM_TALKING_DTYPE=auto

# =============================================================================
# LLM GATEWAY SERVICE CONFIGURATION
# =============================================================================
LLM_GATEWAY_HOST="localhost"
LLM_GATEWAY_GRPC_PORT=50055
LLM_GATEWAY_MAX_CONCURRENCY=10

# VLLM Integration
VLLM_MODEL_NAME="Qwen/Qwen2.5-7B-Instruct"

# RAG Integration
DEFAULT_RETRIEVER_COLLECTION="ege_math"

# =============================================================================
# POSTGRESQL DATABASE CONFIGURATION
# =============================================================================
POSTGRES_HOST="localhost"
POSTGRES_HTTP_PORT=5432
POSTGRES_USER="your_username"
POSTGRES_PASSWORD="your_password"
POSTGRES_DB="llm_service_db"

# =============================================================================
# S3 STORAGE CONFIGURATION
# =============================================================================

s3_access_key="your_access_key"
s3_secret_key="your_secret_key"
s3_endpoint_url="https://your-s3-endpoint.com"
s3_bucket_name="your_bucket_name"
s3_region="your_region"
s3_max_image_size_mb=100
s3_tls_verify=0
s3_public_domain="your_public_domain.com"


