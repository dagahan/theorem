# =============================================================================
# DOCKER & COMPOSE CONFIGURATION
# =============================================================================
COMPOSE_PROJECT_NAME=llm-service
DOCKER_CONTAINERS_RESTART=no
GRPC_MAX_MSG_MB=128
HUGGING_FACE_HUB_TOKEN=""
TZ=UTC
HEALTH_CHECK_TIMEOUT_SEC=5

# =============================================================================
# QDRANT SERVICE CONFIGURATION
# =============================================================================
QDRANT_HOST="localhost"
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_UPSERT_BATCH=1000

# =============================================================================
# HYBRID_EMBEDDER SERVICE CONFIGURATION
# =============================================================================
HYBRID_EMBEDDER_HOST="localhost"
HYBRID_EMBEDDER_GRPC_PORT=50051
HYBRID_EMBEDDER_DIMENSIONS=1024
HYBRID_EMBEDDER_EMBED_BATCH_MAX_SIZE=16
HYBRID_EMBEDDER_MAX_CONCURRENCY=16
HYBRID_EMBEDDER_MAX_SEQ_LENGTH=256
HYBRID_EMBEDDER_MODEL_NAME=BAAI/bge-m3

# PyTorch Configuration
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
TORCH_NUM_THREADS=8

# =============================================================================
# RETRIEVER SERVICE CONFIGURATION
# =============================================================================
RETRIEVER_HOST="localhost"
RETRIEVER_GRPC_PORT=50052
RETRIEVER_MAX_CONCURRENCY=32
DEFAULT_RETRIEVER_COLLECTION="fipi_documents"
RERANK_MODEL_NAME=BAAI/bge-reranker-v2-m3
RERANK_BATCH=16
RERANK_TOPN=25
RERANK_MAX_LEN=512

# =============================================================================
# QUESTION_BUILDER SERVICE CONFIGURATION
# =============================================================================

QUESTION_BUILDER_HOST="localhost"
QUESTION_BUILDER_GRPC_PORT=50056

# =============================================================================
# POLICY_BUILDER SERVICE CONFIGURATION
# =============================================================================

POLICY_BUILDER_HOST="localhost"
POLICY_BUILDER_GRPC_PORT=50057

# =============================================================================
# CONTEXT_BUILDER SERVICE CONFIGURATION
# =============================================================================
   
CONTEXT_BUILDER_HOST="localhost"
CONTEXT_BUILDER_GRPC_PORT=50058

# =============================================================================
# BUDGET_ESTIMATOR SERVICE CONFIGURATION
# =============================================================================

BUDGET_ESTIMATOR_HOST="localhost"
BUDGET_ESTIMATOR_GRPC_PORT=50061
BUDGET_ESTIMATOR_MAX_CONCURRENCY=16

# =============================================================================
# PERSONALITY_BUILDER SERVICE CONFIGURATION
# =============================================================================
   
PERSONALITY_BUILDER_HOST="localhost"
PERSONALITY_BUILDER_GRPC_PORT=50059

# =============================================================================
# INGESTION SERVICE CONFIGURATION
# =============================================================================
INGESTOR_HOST="localhost"
INGESTOR_HTTP_PORT=50053

# gRPC settings
INGESTOR_MAX_WORKERS=10
INGESTOR_GRPC_REFLECTIONS=1

# =============================================================================
# VLLM MATH SERVICE CONFIGURATION
# =============================================================================
VLLM_MATH_HOST="localhost"
VLLM_MATH_PORT=50054

# VLLM Math Model Configuration
VLLM_MATH_MODEL_SRC=hasibirok0/ft-Qwen-Qwen2.5-Math-7B-Instruct-AWQ
VLLM_MATH_MAX_LEN=4096
VLLM_MATH_TP_SIZE=1
VLLM_MATH_HF_CACHE_DIR=/data/hf-cache
VLLM_MATH_GPU_UTIL=0.92
VLLM_MATH_DTYPE=auto

# =============================================================================
# VLLM TALKING SERVICE CONFIGURATION
# =============================================================================
VLLM_TALKING_HOST="192.168.2.187"
VLLM_TALKING_HTTP_PORT=50054

# VLLM Talking Model Configuration
VLLM_TALKING_MODEL_SRC=Qwen/Qwen2.5-7B-Instruct-AWQ
VLLM_TALKING_MAX_LEN=4096
VLLM_TALKING_MIN_RESULTS=150    
VLLM_TALKING_TP_SIZE=2
VLLM_TALKING_HF_CACHE_DIR=/data/hf-cache
VLLM_TALKING_GPU_UTIL=0.92
VLLM_TALKING_DTYPE=auto

# =============================================================================
# TIMEOUT CONFIGURATION
# =============================================================================
CONTEXT_BUILDER_NODE_TIMEOUT_SEC=180
QUESTION_BUILDER_NODE_TIMEOUT_SEC=30
RETRIEVAL_NODE_TIMEOUT_SEC=120
PERSONALITY_NODE_TIMEOUT_SEC=15
LLM_GENERATION_NODE_TIMEOUT_SEC=90

# =============================================================================
# LLM GATEWAY SERVICE CONFIGURATION
# =============================================================================
LLM_GATEWAY_HOST="0.0.0.0"
LLM_GATEWAY_GRPC_PORT=50055
LLM_GATEWAY_MAX_CONCURRENCY=50
VLLM_MODEL_NAME="Qwen2.5-3B-Instruct-AWQ"


# =============================================================================
# AGENT CONTROLLER SERVICE CONFIGURATION
# =============================================================================
AGENT_CONTROLLER_HOST="localhost"
AGENT_CONTROLLER_GRPC_PORT=50060
AGENT_CONTROLLER_MAX_CONCURRENCY=50



# =============================================================================
# POSTGRESQL DATABASE CONFIGURATION
# =============================================================================
POSTGRES_HOST="localhost"
POSTGRES_HTTP_PORT=5432
POSTGRES_USER="your_username"
POSTGRES_PASSWORD="your_password"
POSTGRES_DB="llm_service_db"

# =============================================================================
# S3 STORAGE CONFIGURATION
# =============================================================================

s3_access_key=your_s3_access_key
s3_secret_key=your_s3_secret_key
s3_endpoint_url=https://s3.ru-1.storage.selcloud.ru
s3_bucket_name=your_bucket_name
s3_region=ru-1
s3_max_image_size_mb=100
s3_tls_verify=0
s3_public_domain=your_public_domain.selstorage.ru

# =============================================================================
# GATEWAY SERVICE CONFIGURATION
# =============================================================================
GATEWAY_HOST=your_gateway_host
GATEWAY_PORT=8080
GATEWAY_PROTOCOL=http
GATEWAY_CORS_ORIGIN=*
SERVER_ADDR=:8080
CORS_ORIGIN=*

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================
FRONTEND_HOST=your_frontend_host
FRONTEND_PORT=4173
FRONTEND_PROTOCOL=http
FRONTEND_NGINX_PORT=4173
FRONTEND_NGINX_DEV_PORT=5173

# API Configuration
API_BASE_URL=http://your_gateway_host:8080
API_TIMEOUT=10000

# Development Configuration
NODE_ENV=production
VITE_API_BASE_URL=http://your_gateway_host:8080

# =============================================================================
# USER SERVICE CONFIGURATION
# =============================================================================
USER_SERVICE_GRPC_SERVER_ADDR=localhost:8085