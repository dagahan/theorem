{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim_id": { "type": "string", "minLength": 1, "maxLength": 50 },
          "text": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "citations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "url": { "type": "string", "minLength": 1 },
                "title": { "type": "string", "maxLength": 200 },
                "time": { "type": "string", "maxLength": 50 }
              },
              "required": ["url"],
              "additionalProperties": false
            }
          },
          "support": { "type": "integer", "minimum": 0 },
          "contradict": { "type": "integer", "minimum": 0 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "freshness_days": { "type": "integer", "minimum": 0 },
          "source_trust": { "type": "number", "minimum": 0, "maximum": 1 },
          "retrieval_score": { "type": "number" },
          "clusters": {
            "type": "array",
            "items": { "type": "string", "maxLength": 50 }
          }
        },
        "required": ["claim_id", "text", "citations", "support", "contradict", "confidence"],
        "additionalProperties": false
      }
    }
  },
  "required": ["claims"],
  "additionalProperties": false
}