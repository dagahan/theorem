{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "subgoals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 50 },
          "need": { "type": "string", "minLength": 1, "maxLength": 300 }
        },
        "required": ["id", "need"],
        "additionalProperties": false
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 50 },
          "tool": { "type": "string", "minLength": 1, "maxLength": 100 },
          "args": { "type": "object" },
          "produces": {
            "type": "array",
            "items": { "type": "string", "maxLength": 100 }
          }
        },
        "required": ["id", "tool", "args"],
        "additionalProperties": false
      }
    }
  },
  "required": ["subgoals", "actions"],
  "additionalProperties": false
}