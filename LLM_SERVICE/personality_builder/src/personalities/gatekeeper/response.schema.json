{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "coverage": { "type": "number", "minimum": 0, "maximum": 1 },
    "decision": { "type": "string", "enum": ["loop", "exit"] },
    "missing_subgoals": {
      "type": "array",
      "items": { "type": "string", "maxLength": 200 }
    },
    "contradictions": {
      "type": "array",
      "items": { "type": "string", "maxLength": 200 }
    },
    "next_hints": {
      "type": "array",
      "items": { "type": "string", "maxLength": 200 }
    },
    "confidence_summary": { "type": "string", "maxLength": 500 },
    "budget_warning": { "type": "string", "maxLength": 200 }
  },
  "required": ["coverage", "decision"],
  "additionalProperties": false
}